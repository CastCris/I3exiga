<?xml version="1.0" encoding="UTF-8"?>
<taglib xmlns="https://jakarta.ee/xml/ns/jakartaee"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-jsptaglibrary_3_0.xsd"
        version="3.0">
    <description>Tags e funções de apoio às páginas (substituem a JSTL, que não vem com o Tomcat).</description>
    <tlib-version>1.0</tlib-version>
    <short-name>v</short-name>
    <uri>i3exiga/view</uri>

    <tag>
        <name>if</name>
        <tag-class>br.edu.ifsp.i3exiga.web.view.IfTag</tag-class>
        <body-content>scriptless</body-content>
        <attribute>
            <name>test</name>
            <required>true</required>
            <rtexprvalue>true</rtexprvalue>
            <type>boolean</type>
        </attribute>
    </tag>

    <tag>
        <name>each</name>
        <tag-class>br.edu.ifsp.i3exiga.web.view.EachTag</tag-class>
        <body-content>scriptless</body-content>
        <attribute>
            <name>items</name>
            <required>true</required>
            <rtexprvalue>true</rtexprvalue>
            <type>java.lang.Object</type>
        </attribute>
        <attribute>
            <name>var</name>
            <required>true</required>
            <rtexprvalue>false</rtexprvalue>
        </attribute>
    </tag>

    <function>
        <name>h</name>
        <function-class>br.edu.ifsp.i3exiga.web.view.ViewFunctions</function-class>
        <function-signature>java.lang.String escape(java.lang.Object)</function-signature>
    </function>
    <function>
        <name>date</name>
        <function-class>br.edu.ifsp.i3exiga.web.view.ViewFunctions</function-class>
        <function-signature>java.lang.String date(java.time.Instant)</function-signature>
    </function>
    <function>
        <name>join</name>
        <function-class>br.edu.ifsp.i3exiga.web.view.ViewFunctions</function-class>
        <function-signature>java.lang.String join(java.util.Collection)</function-signature>
    </function>
    <function>
        <name>enc</name>
        <function-class>br.edu.ifsp.i3exiga.web.view.ViewFunctions</function-class>
        <function-signature>java.lang.String enc(java.lang.String)</function-signature>
    </function>
    <function>
        <name>contains</name>
        <function-class>br.edu.ifsp.i3exiga.web.view.ViewFunctions</function-class>
        <function-signature>boolean contains(java.util.Collection, java.lang.Object)</function-signature>
    </function>
</taglib>
